---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from 'layouts/Layout.astro';

export async function getStaticPaths() {
  return (await getCollection('blog')).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en', { dateStyle: 'long', timeZone: 'UTC' });
---

<Layout title={`${post.data.title} — dora blog`} description={post.data.description}>
  <article class="mx-auto max-w-4xl px-4 pb-24 pt-32 lg:px-9">
    <a href="/blog/" class="text-accent">← All posts</a>
    <header class="mb-12 mt-10 border-b border-surface-3 pb-10">
      <time datetime={post.data.date.toISOString()} class="font-mono text-sm text-neutral-2">{date}</time>
      <h1 class="mt-4 text-4xl font-medium leading-tight text-text-bright sm:text-5xl">{post.data.title}</h1>
      <a href={`https://github.com/dora-rs/dora/blob/main/docs/blog/${post.data.blogSource}`} class="mt-6 inline-block text-sm text-accent">View source on GitHub</a>
    </header>
    <div class="blog-prose"><Content /></div>
  </article>
</Layout>

<style is:global>
  .blog-prose { font-size: 1.125rem; line-height: 1.8; overflow-wrap: anywhere; }
  .blog-prose :is(p, ul, ol, pre, table, blockquote) { margin-block: 1.5rem; }
  .blog-prose :is(h2, h3, h4) { color: var(--color-text-bright); font-weight: 500; line-height: 1.3; margin-block: 2.5rem 1rem; }
  .blog-prose h2 { font-size: 1.875rem; }
  .blog-prose h3 { font-size: 1.5rem; }
  .blog-prose a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .blog-prose ul { list-style: disc; padding-left: 1.5rem; }
  .blog-prose ol { list-style: decimal; padding-left: 1.5rem; }
  .blog-prose li { margin-block: 0.5rem; }
  .blog-prose pre { padding: 1.25rem; border: 1px solid var(--color-surface-3); border-radius: 0.5rem; overflow-x: auto; font-size: 0.875rem; }
  .blog-prose :not(pre) > code { color: var(--color-code); font-size: 0.9em; }
  .blog-prose table { display: block; overflow-x: auto; border-collapse: collapse; font-size: 0.95rem; }
  .blog-prose :is(th, td) { border: 1px solid var(--color-surface-3); padding: 0.75rem; text-align: left; }
  .blog-prose blockquote { border-left: 3px solid var(--color-accent); padding-left: 1.25rem; color: var(--color-text-dim); }
  .blog-prose img { max-width: 100%; height: auto; }
</style>
